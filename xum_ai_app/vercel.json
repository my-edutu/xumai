{
    "rewrites": [
        {
            "source": "/lingualink",
            "destination": "/"
        },
        {
            "source": "/(.*)\\.(apk|aab|ipa|txt|pdf|zip)",
            "destination": "/$1.$2"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite"
}